{
  "name": "sal-pos",
  "version": "1.0.36",
  "description": "Sal POS POS Desktop App",
  "author": "Sal POS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist-mac": "electron-builder --mac",
    "dist-linux": "electron-builder --linux",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js"
  },
  "build": {
    "appId": "com.sal.pos",
    "productName": "Sal POS",
    "copyright": "Copyright 2024 Sal POS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.html",
      "styles.css",
      "main.js",
      "server.js",
      "database.js",
      "printer.js",
      "preload.js",
      "services/**",
      "icon.png",
      "!**/*credentials*.json",
      "!**/*.db",
      "!tests/**",
      "!scripts/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      },
      {
        "from": "marketing-images",
        "to": "marketing-images"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sal POS",
      "license": null,
      "perMachine": false,
      "allowElevation": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "offers-png",
        "repo": "sal-pos-",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.4.15",
    "electron-updater": "^6.8.9",
    "express": "^4.22.3",
    "googleapis": "^181.0.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1"
  }
}
